# ==============================================================================
# The Executive Brief by OU DBM - Environment Template
# Copy this file to .env.local and populate with your own project credentials.
# NEVER commit real credentials, service keys, or database passwords to Git.
# ==============================================================================

# Content Source Mode: 'local' (default) or 'supabase'
# Set to 'supabase' to connect to the Supabase PostgreSQL backend.
CONTENT_SOURCE=local

# Supabase API Credentials
# Obtained from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Editorial Session HMAC-SHA256 Signing Secret (SERVER-SIDE ONLY)
# Must be at least 32 characters in production. Generate with: openssl rand -base64 32
SESSION_SECRET=your-random-32-char-session-signing-secret

# ==============================================================================
# NEWSLETTER & EMAIL CAMPAIGN SYSTEM CONFIGURATION
# ==============================================================================

# Gmail SMTP Configuration with Google App Password (SERVER-SIDE ONLY)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

# Publication Sender Identities
NEWSLETTER_FROM_NAME=The Executive Brief
NEWSLETTER_FROM_EMAIL=executivebrief@oudbm.ac.in
NEWSLETTER_REPLY_TO=executivebrief@oudbm.ac.in

# Recipient Source Selection:
# 'newsletter_test_subscribers' (Default during testing - 3 seeded addresses)
# 'subscribers' (Production table - switch to this after testing)
NEWSLETTER_RECIPIENT_SOURCE=newsletter_test_subscribers

# Cryptographically Secure Unsubscribe Signing Secret (SERVER-SIDE ONLY)
NEWSLETTER_UNSUBSCRIBE_SECRET=your-random-32-char-unsubscribe-secret
