# ==============================================================================
# The Executive Brief by OU DBM - Environment Template
# Copy this file to .env.local and populate with your own project credentials.
# NEVER commit real credentials, service keys, or database passwords to Git.
# ==============================================================================

# Content Source Mode: 'local' (default) or 'supabase'
# Keep 'local' during local development and testing to use src/data/mockArticles.ts
CONTENT_SOURCE=local

# Supabase API Credentials
# Obtained from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used only by backend management scripts or webhook handlers
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
