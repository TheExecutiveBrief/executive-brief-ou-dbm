# ==============================================================================
# The Executive Brief by OU DBM - Environment Template
# Copy this file to .env.local and populate with your own project credentials.
# NEVER commit real credentials, service keys, or database passwords to Git.
# ==============================================================================

# Content Source Mode: 'local' (default) or 'supabase'
# Keep 'local' during local development and testing to use src/data/mockArticles.ts
CONTENT_SOURCE=local

# Supabase API Credentials
# Obtained from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Supabase Service Role Key (NOT REQUIRED by this application)
# The application uses least-privilege access: public anon key + authenticated user JWT tokens.
# The service role key bypasses Row Level Security and is NOT needed for normal operation.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Editorial Session HMAC-SHA256 Signing Secret (SERVER-SIDE ONLY)
# Must be at least 32 characters in production. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-char-random-secret-for-production
